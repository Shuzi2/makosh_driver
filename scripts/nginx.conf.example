# Company reverse proxy; replace the domain and certificate paths.
server {
    listen 80;
    server_name fleet.company.ua;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name fleet.company.ua;
    ssl_certificate /etc/letsencrypt/live/fleet.company.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fleet.company.ua/privkey.pem;
    client_max_body_size 22m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 100s;
    }
    # Do not add an alias for /data/uploads or private-media.
}
