# Generate a real .env with: python3 scripts/init_env.py --local
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=makosh
POSTGRES_USER=makosh
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=1
DJANGO_HTTPS_REDIRECT=1
DJANGO_TRUST_PROXY=0
DJANGO_HSTS_SECONDS=3600
WEB_PORT=8000
